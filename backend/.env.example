# Backend Environment Variables Template
# Copy this to .env and fill in your actual values

# ==================== Server Configuration ====================
PORT=5000
NODE_ENV=production

# ==================== Database ====================
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0"

# ==================== JWT Secrets ====================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# ==================== Frontend URLs ====================
FRONTEND_URL=https://localhost:5173
BACKEND_PUBLIC_URL=https://localhost:5000

# ==================== Cloudinary Configuration ====================
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset

# ==================== Mailjet Configuration ====================
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_API_SECRET=your_mailjet_api_secret
MAILJET_FROM_EMAIL=your_sender_email@example.com
MAILJET_FROM_NAME=NITKKR


# Fallback sender info (if Mailjet env vars not set)
SMTP_FROM=your_sender_email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PASS=your_smtp_password
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_sender_email@example.com

# Email send timeout in milliseconds
EMAIL_SEND_TIMEOUT_MS=15000

# ==================== Admin Configuration ====================
# Default admin email for setup-admin script
ADMIN_EMAIL=admin@nitkkr.ac.in
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin User


